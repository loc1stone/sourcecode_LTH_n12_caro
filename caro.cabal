cabal-version:      2.4
name:               caro
version:            0.1.0.0
synopsis:           Cờ caro (Gomoku) bằng Haskell: luật thuần, parser, song song/STM, lưu tệp và chơi qua socket
build-type:         Simple
extra-source-files: gui/index.html

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -O1
  build-depends:    base >=4.14 && <5
                  , containers
                  , parsec
                  , stm
                  , directory
                  , network >=3.1
                  , bytestring
                  , text
                  , process
                  , template-haskell

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Caro.Types
                    Caro.Rules
                    Caro.Pretty
                    Caro.Parser
                    Caro.Protocol
                    Caro.Storage
                    Caro.AI
                    Caro.Parallel
                    Caro.Session
                    Caro.App
                    Caro.Net
                    Caro.Cli
                    Caro.Ascii
                    Caro.Json
                    Caro.Gui
                    Caro.Gui.Assets

executable caro
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    caro
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

test-suite caro-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:    caro
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N2"
